<!DOCTYPE html>
<html lang="es">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Recursos complementarios | Ruta de Aprendizaje</title>
	<style>
		:root { --azul:#17324d; --turquesa:#35b8b0; --amarillo:#f5c451; --coral:#e9826d; --texto:#263746; --borde:#d8e4e9; }
		* { box-sizing:border-box; }
		body { margin:0; background:#f4f7f9; color:var(--texto); font-family:Arial,Helvetica,sans-serif; line-height:1.45; }
		.contenedor { width:100%; max-width:840px; margin:0 auto; padding:8px 10px 14px; }
		.carrusel { position:relative; padding:0 44px; }
		.lista { overflow:hidden; }
		.recurso { display:grid; grid-template-columns:minmax(0,1fr) auto; align-items:center; gap:13px; min-height:86px; padding:13px 15px; border:1px solid var(--borde); border-left:4px solid var(--turquesa); border-radius:9px; background:#fff; box-shadow:0 4px 14px rgba(23,50,77,.07); }
		.recurso[hidden] { display:none; }
		.recurso:nth-child(2) { border-left-color:var(--amarillo); }
		.recurso:nth-child(3) { border-left-color:var(--coral); }
		.recurso:nth-child(4) { border-left-color:var(--azul); }
		.nombre { min-width:0; }
		.nombre strong { display:block; overflow-wrap:anywhere; color:var(--azul); font-size:.94rem; }
		.nombre span { display:block; margin-top:2px; color:#687681; font-size:.78rem; }
		.descargar { display:inline-flex; align-items:center; justify-content:center; min-width:104px; padding:9px 12px; border-radius:7px; background:var(--turquesa); color:#fff; font-size:.8rem; font-weight:bold; text-decoration:none; }
		.descargar:hover, .descargar:focus-visible { background:#258e89; outline:3px solid rgba(53,184,176,.3); outline-offset:2px; }
		.control { position:absolute; top:50%; display:grid; place-items:center; width:32px; height:32px; transform:translateY(-50%); border:1px solid var(--borde); border-radius:50%; background:#fff; color:var(--azul); cursor:pointer; font-size:1.25rem; line-height:1; box-shadow:0 3px 9px rgba(23,50,77,.1); }
		.control:hover, .control:focus-visible { border-color:var(--turquesa); color:var(--turquesa); outline:3px solid rgba(53,184,176,.2); outline-offset:2px; }
		.anterior { left:4px; }
		.siguiente { right:4px; }
		.indicadores { display:flex; justify-content:center; gap:7px; padding-top:10px; }
		.indicador { width:8px; height:8px; padding:0; border:0; border-radius:50%; background:#c4d3d9; cursor:pointer; }
		.indicador.activo { background:var(--turquesa); transform:scale(1.25); }
		@media (max-width:560px) {
			.contenedor { padding:6px 8px 12px; }
			.carrusel { padding:0 36px; }
			.recurso { grid-template-columns:1fr; gap:10px; padding:11px; }
			.descargar { width:100%; }
		}
	</style>
</head>
<body>
	<main class="contenedor">
		<div class="carrusel" aria-label="Recursos complementarios">
			<button class="control anterior" type="button" aria-label="Recurso anterior">&#8249;</button>
			<div class="lista">
				<article class="recurso" aria-hidden="false">
					<div class="nombre"><strong>Guía general de la ruta formativa</strong><span>Documento de la ruta formativa</span></div>
					<a class="descargar" href="recursos%20ruta%20de%20aprendizaje/Ruta%20Formativa.pdf" download>Descargar</a>
				</article>
				<article class="recurso" aria-hidden="true" hidden>
					<div class="nombre"><strong>Presentación editable de la ruta</strong><span>Presentación editable</span></div>
					<a class="descargar" href="recursos%20ruta%20de%20aprendizaje/Ruta%20Formativa.pptx" download>Descargar</a>
				</article>
				<article class="recurso" aria-hidden="true" hidden>
					<div class="nombre"><strong>Mapa visual de salud mental</strong><span>Vista general de la ruta</span></div>
					<a class="descargar" href="recursos%20ruta%20de%20aprendizaje/Ruta_formativa_de_salud_mental.png" download>Descargar</a>
				</article>
				<article class="recurso" aria-hidden="true" hidden>
					<div class="nombre"><strong>Presentación de apoyo Mineduc</strong><span>Material institucional de apoyo</span></div>
					<a class="descargar" href="recursos%20ruta%20de%20aprendizaje/ruta_formativa_salud_mental_mineduc.pptx" download>Descargar</a>
				</article>
			</div>
			<button class="control siguiente" type="button" aria-label="Siguiente recurso">&#8250;</button>
			<div class="indicadores" aria-label="Seleccionar recurso"></div>
		</div>
	</main>
	<script>
		const recursos = [...document.querySelectorAll('.recurso')];
		const indicadores = document.querySelector('.indicadores');
		let actual = 0;

		recursos.forEach((_, indice) => {
			const indicador = document.createElement('button');
			indicador.className = 'indicador';
			indicador.type = 'button';
			indicador.ariaLabel = `Mostrar recurso ${indice + 1}`;
			indicador.addEventListener('click', () => mostrar(indice));
			indicadores.append(indicador);
		});

		function mostrar(indice) {
			actual = (indice + recursos.length) % recursos.length;
			recursos.forEach((recurso, posicion) => {
				const visible = posicion === actual;
				recurso.hidden = !visible;
				recurso.setAttribute('aria-hidden', String(!visible));
			});
			[...indicadores.children].forEach((indicador, posicion) => {
				indicador.classList.toggle('activo', posicion === actual);
				indicador.setAttribute('aria-current', posicion === actual ? 'true' : 'false');
			});
		}

		document.querySelector('.anterior').addEventListener('click', () => mostrar(actual - 1));
		document.querySelector('.siguiente').addEventListener('click', () => mostrar(actual + 1));
		mostrar(0);
	</script>
</body>
</html>
